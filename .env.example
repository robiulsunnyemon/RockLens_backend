# Application Configuration
PROJECT_NAME="RockLens Geological Intelligence API"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
SECRET_KEY="replace_with_a_secure_random_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL Database Configuration
DATABASE_HOST="postgres"
DATABASE_PORT=5432
DATABASE_USER="postgres"
DATABASE_PASSWORD="your_database_password"
DATABASE_NAME="rocklens"
DATABASE_URL="postgresql+asyncpg://postgres:your_database_password@postgres:5432/rocklens"
DATABASE_SYNC_URL="postgresql+psycopg2://postgres:your_database_password@postgres:5432/rocklens"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_smtp_app_password"
SMTP_FROM_EMAIL="noreply@rocklens.io"
SMTP_FROM_NAME="RockLens Geological Vault"
SMTP_TLS=True

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Google Cloud Vision API Configuration (For High-Accuracy Online Rock Identification)
# You can provide either a Google Cloud Vision API Key or the path to a Google Service Account JSON file.
GOOGLE_VISION_API_KEY="AIzaSy..."
GOOGLE_APPLICATION_CREDENTIALS=""
GEMINI_API_KEY=""
